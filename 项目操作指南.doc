  @page {
    size: A4;
    margin: 2cm;
  }
  body {
    font-family: "Microsoft YaHei", "PingFang SC", -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #1a1a18;
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
  }
  a { color: #5b726c; }
  strong { color: #1a1a18; }
</style>
